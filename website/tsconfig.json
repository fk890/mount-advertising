{
  "exclude": ["node_modules"],
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "plugins": [{ "name": "next" }],
    "baseUrl": "./src",
    "paths": {
      "~/public/*": ["../public/*"],
      "~/*": ["./*"],
      "@/shop-components/*": ["./shop-components/*"],
      "@/shop-types/*": ["./shop-types/*"],
      "@/shop-utils/*": ["./shop-utils/*"],
      "@/shop-styles/*": ["./shop-styles/*"],
      "@/shop-hooks/*": ["./shop-hooks/*"]
    }
  },
  "include": ["src", "next-env.d.ts", ".next/types/**/*.ts"]
}
